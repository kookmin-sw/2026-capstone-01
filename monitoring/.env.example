# Krip 프로젝트 루트 .env.example
#
# docker-compose 가 자동 로드하는 project root .env 의 템플릿.
# `cp .env.example .env` 후 실제 값 입력. .gitignore 등록되어 있음.
#
# 메인 backend 환경변수는 backend/.env (별도) — 본 파일은 모니터링 스택 (monitoring/) 만 담당.

# ─── 환경 (Prometheus external_labels.env 자동 부착) ───
ENV=DEV

# ─── 노드 식별자 (Promtail Loki 라벨) ───
# 멀티 노드 진입 시 노드별로 다른 값. 단일 인스턴스 dev 는 default 유지.
NODE_ID=krip-backend

# ─── Grafana (admin 비번 강제) ───
GRAFANA_ADMIN_PASSWORD=changeme

# ─── 데이터스토어 자격증명 (exporter 가 사용) ───
# 메인 docker-compose.yml 의 PG / Mongo / Redis 비번과 동일해야 함.
# backend/.env 와 중복이지만 docker-compose substitution 은 project root .env 만 자동 로드.
POSTGRES_USER=cho
POSTGRES_PASSWORD=hyeonsang
POSTGRES_NAME=chohyeonsang
MONGODB_USER=cho
MONGODB_PASSWORD=hyeonsang
