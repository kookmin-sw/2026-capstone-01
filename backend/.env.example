# 서버
HOST=
PORT=

# CORS 프론트 설정
FRONTEND_URL=
LOCAL_FRONTEND_URL=
APP_ALLOWED_ORIGINS=

# 환경
ENVIRONMENT=

# 로깅 설정
LOG_LEVEL=INFO
# ⚠️ PROD 에서는 반드시 json. console 로 두면 Promtail JSON parser 가 깨져 모든 라벨이
#    unknown 으로 들어가고 14 일치 로그 검색 불가. logger.py 가 ENVIRONMENT=PROD 일 때
#    fail-safe 로 json 강제 변환하지만 명시 권장.
LOG_FORMAT=json
LOG_FILE_PATH=/backend/logs/app.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_COMPRESSION=gz

# 모니터링
METRICS_PORT=9090

# POSTGRES 정보
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_NAME=

# MongoDB 정보
MONGODB_HOST=
MONGODB_PORT=
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_NAME=

# Redis 정보
REDIS_HOST=
REDIS_PORT=
REDIS_DB=                       # 핫 데이터 (세션 / 시퀀스 / unread)
REDIS_DB_DEDUPE=1               # dedupe 키 격리 — KEYS dedupe:* 사고가 핫 데이터에 영향주지 않도록 분리

# 채팅 fan-out
FANOUT_MODE=in_process          # 멀티노드 진입 시 node_channel 로 변경
NODE_ID=                        # 단일 노드 dev 는 비워둠 (hostname default). 멀티 워커 운영 시 명시 권장.

# 인증 정보
ACCESS_TOKEN=

# USER LOGIN JWT 설정
USER_LOGIN_JWT_SECRET_KEY=
USER_LOGIN_JWT_ALGORITHM=
USER_LOGIN_JWT_EXPIRATION_DAYS=
USER_LOGIN_COOKIE_NAME=

# 공유 JWT 설정
SHARE_JWT_SECRET_KEY=
SHARE_JWT_ALGORITHM=
SHARE_JWT_EXPIRATION_DAYS=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Redirect Base URL
OAUTH_REDIRECT_BASE_URL=

# NaverCloud S3 Object Storage 설정
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=

# LLM
GOOGLE_GEMINI_API_KEY=

# Papago (Naver Developers)
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=

# FCM (Firebase Cloud Messaging)
FCM_CREDENTIALS_PATH=secrets/krip-firebase-secret-key.json   # backend/ 기준 상대 경로 또는 절대

# Langsmith(Optional)
LANGCHAIN_TRACING_V2=
LANGCHAIN_ENDPOINT=
LANGCHAIN_PROJECT=
LANGCHAIN_API_KEY=